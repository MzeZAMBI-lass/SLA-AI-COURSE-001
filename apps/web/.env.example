# Supabase — public keys safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (set to your Render service URL in production)
NEXT_PUBLIC_API_URL=http://localhost:3001

# School location for the map centre
NEXT_PUBLIC_SCHOOL_LATITUDE=-3.7321
NEXT_PUBLIC_SCHOOL_LONGITUDE=36.6858
