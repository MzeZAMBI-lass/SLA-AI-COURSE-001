# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Supabase — get these from your Supabase project settings
# NEXT_PUBLIC_ prefix is required for the Next.js frontend (inlined at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only — never expose to client
# API also reads SUPABASE_URL / SUPABASE_ANON_KEY (no NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# WhatsApp
WHATSAPP_WEBHOOK_SECRET=your-webhook-hmac-secret   # Used to verify incoming webhook signatures
WHATSAPP_API_TOKEN=your-business-api-token         # Phase 2 — official Business API
WHATSAPP_PHONE_NUMBER_ID=your-phone-id             # Phase 2 — official Business API

# Mapping APIs
ORS_API_KEY=your-openrouteservice-key              # Free at openrouteservice.org
GOOGLE_MAPS_API_KEY=your-key                       # Optional fallback geocoding

# School Configuration
SCHOOL_LATITUDE=-3.7321
SCHOOL_LONGITUDE=36.6858
SCHOOL_START_TIME=07:30
MAX_SERVICE_DISTANCE_KM=50
